{% extends "_base.html.jinja" %}
{% block content %}
  <p style="color: #333; font-size: 16px; line-height: 1.5;">Hi {{ greeting }},</p>
  <p style="color: #333; font-size: 16px; line-height: 1.5;"><strong>{{ request_name }}</strong> {{ sentence }}</p>
  {% if team_note %}
  <div style="background-color: #faf7f2; border-left: 3px solid #c2410c; padding: 12px 16px; margin: 24px 0;">
    <p style="color: #666; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; margin: 0 0 8px;">A note from the Resource Circle</p>
    <p style="color: #333; font-size: 15px; line-height: 1.5; margin: 0; white-space: pre-line;">{{ team_note }}</p>
  </div>
  {% endif %}
  <p style="color: #666; font-size: 14px; line-height: 1.5;">Sign in to the {{ app_name }} to follow your request.</p>
{% endblock %}
