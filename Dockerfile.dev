FROM python:3.11-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# `--no-install-recommends` matches `Dockerfile:17` and `.github/workflows/test.yml:34`, which
# already pass it; this line was the last holdout. Without it `ffmpeg` pulls its full recommends
# closure — mesa, GTK 3, X11, SDL2, LLVM, the VA/VDPAU video drivers. An API container uses none
# of them, and production ships none of them: a dev image carrying packages prod lacks is how a
# missing production dependency stays hidden until it reaches production.
#
# It also shrinks, but does not remove, the exposure to a separate network-side failure. The CDN
# serving deb.debian.org can begin refusing connections partway through a long fetch, and a
# refusal with nothing to catch it kills the layer. `Acquire::Retries`, `Acquire::Queue-Mode` and
# `Acquire::http::Pipeline-Depth` were each measured against a refusal window and none rescued
# one — narrower than saying they do nothing — so none is set here. Re-running the build is the
# remedy when it happens.
RUN apt-get update && apt-get install -y --no-install-recommends gcc ffmpeg && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --group dev

COPY . .

ENV PATH="/opt/venv/bin:$PATH"
ENV PORT=8000
EXPOSE 8000

# `heads`, plural, and not `head`. An integration branch bifurcates its Alembic graph every
# time the chain composes again — three heads stood here on 2026-08-21 — and `head` refuses
# to resolve while more than one exists, so the container would not boot at all. `heads`
# applies every one of them, and once they are joined it is the same command: with a single
# head, `heads` and `head` do the same thing, so this is not a special case anybody has to
# undo later.
#
# **This weakens no gate.** The `migrations` job in CI runs `head` and goes on running it —
# that job is what refuses a bifurcated graph, and it is the only thing that catches one,
# since pytest builds its tables directly and never sees the graph at all. Policing the
# graph is that job's business. The development container's business is to run.
CMD ["sh", "-c", "uv run alembic upgrade heads && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
