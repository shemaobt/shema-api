.git
.worktrees
.venv
.mypy_cache
.ruff_cache
.pytest_cache
__pycache__
*.pyc
*.db

# `**/` because a pattern is matched against the whole path and `*` does not cross a `/`:
# a bare `*.dump` would miss `.local-dump/latest.dump`, which is production data.
**/*.dump
node_modules

# Credentials. Dockerfile.dev ends in `COPY . .`, and compose mounts these at
# runtime, so nothing needs them in a layer.
.env
.env.*
gcs-signing-key.json
